# Tatum: https://dashboard.tatum.io/ (API key for the Sui gateway)
TATUM_API_KEY=

# Walrus Memory: create an account and delegate key at
#   https://memory.walrus.xyz (mainnet) or https://staging.memory.walrus.xyz (testnet)
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
# testnet while building, mainnet for the demo and submission
MEMWAL_NETWORK=testnet
# Optional: point at your own relayer
# MEMWAL_SERVER_URL=

# Set to 1 to run with an in-memory mock (no keys needed, nothing is stored)
# MEMWAL_MOCK=1
