# Copy to .env and fill in. Never commit .env.

# Tatum: https://dashboard.tatum.io/ (API key for the Sui gateway)
TATUM_API_KEY=

# Walrus Memory: create an account and delegate key at
#   https://memory.walrus.xyz (mainnet) or https://staging.memory.walrus.xyz (testnet)
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
# testnet while building, mainnet for the demo and submission
MEMWAL_NETWORK=testnet
# Optional: point at your own relayer
# MEMWAL_SERVER_URL=

# Set to 1 to run with an in-memory mock (no keys needed, nothing is stored)
# MEMWAL_MOCK=1

# x402 pay-per-pick on Sui (all chain calls go through the Tatum Sui gateway)
# mainnet (default) or testnet
PAYMENTS_NETWORK=mainnet
# The agent's own Sui wallet (suiprivkey1...). Use a fresh wallet holding only a
# little USDC and SUI for gas; never your main wallet.
AGENT_SUI_PRIVATE_KEY=
# Where sealed-pick payments go by default (the tipster's address, 0x + 64 hex)
SELLER_SUI_ADDRESS=
# The agent only pays sources at or above this trust, up to this price per pick
AGENT_MIN_TRUST=55
AGENT_MAX_PRICE_USDC=0.25
# Set to 1 to fake the chain (nothing is paid)
# PAYMENTS_MOCK=1
